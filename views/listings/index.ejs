<% layout("layouts/boilerplate") %>

<h2 class="mb-4">Explore Listings</h2>

<div class="row">
  <% allListings.forEach(listing => { %>

    <div class="col-md-4 mb-4">
      <div class="card listing-card">

        <img src="<%= listing.image %>" class="card-img-top" alt="">

        <div class="card-body">
          <h5><%= listing.title %></h5>
          <p>₹ <%= listing.price %></p>

          <a href="/listings/<%= listing._id %>" class="btn btn-dark">
            View
          </a>
        </div>

      </div>
    </div>

  <% }) %>
</div>